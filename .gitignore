# Terraform
.terraform*/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
*.tfvars.local
plan.txt
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.venv*/
venv/
env/

# Java / Spark
*.jar
*.class

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# GCP credentials – never commit these. JSON is blanket-ignored because
# service-account keys default to un-guessable names (<project>-<hex>.json);
# negate intentionally tracked JSON files explicitly below.
*.json
!.devcontainer/devcontainer.json
!infra/modules/bq_ops/schemas/*.json
secrets/

# Local environment – never commit these
.env
.env.*
!.env.example
!config/schemas/*.json
