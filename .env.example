# Copy to .env and fill in. .env is gitignored - never commit real values.
# Mirrors the variables the GitHub Actions workflows expect.

# Maps to the GCP_PROJECT_ID repo secret/variable
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-east1

# Terraform reads TF_VAR_* automatically
TF_VAR_project_id=your-project-id
TF_VAR_pipeline_service_account=terraform-runner@your-project-id.iam.gserviceaccount.com

# Path to the service account JSON key (keep outside git; secrets/ is ignored)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json
