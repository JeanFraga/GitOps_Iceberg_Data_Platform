{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eras.schema.json",
  "title": "Era registry (config/eras/<source>.yaml): feed -> era -> {fingerprint, columns}",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {"pattern": "^[a-z0-9_]+$"},
  "additionalProperties": {
    "type": "object",
    "minProperties": 1,
    "propertyNames": {"pattern": "^[a-z0-9_]+$"},
    "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "columns"],
      "properties": {
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}}
      }
    }
  }
}
