{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "Resolved client profile (AD-1 config contract)",
  "description": "Validates defaults.yaml deep-merged with config/profiles/<profile>.yaml plus versions.yaml. Later entries add keys here as they add them to the contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "project_id",
    "region",
    "flags",
    "versions",
    "drift",
    "billing_account",
    "budget",
    "run",
    "datagen"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]+-[a-z]+[0-9]+$"
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflows_enabled",
        "composer_enabled",
        "dataproc_schedule_enabled",
        "ml_fallback_enabled"
      ],
      "properties": {
        "workflows_enabled": {
          "type": "boolean",
          "default": false
        },
        "composer_enabled": {
          "type": "boolean",
          "default": false
        },
        "dataproc_schedule_enabled": {
          "type": "boolean",
          "default": false
        },
        "ml_fallback_enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "versions": {
      "type": "object"
    },
    "drift": {
      "description": "D-7 data-drift thresholds. Unknown until decided: unset thresholds mean report only (no Gold block).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_drift_thresholds",
        "mode"
      ],
      "properties": {
        "data_drift_thresholds": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "mode": {
          "enum": [
            "report_only",
            "block"
          ]
        }
      }
    },
    "billing_account": {
      "type": "string",
      "pattern": "^[0-9A-F]{6}-[0-9A-F]{6}-[0-9A-F]{6}$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount_usd",
        "alert_thresholds"
      ],
      "properties": {
        "amount_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "alert_thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "cost": {
      "description": "AD-16 bytes-billed cap. Not required here: `make lint-bytes-cap` is the gate.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_bytes_billed": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_ttl_minutes"
      ],
      "properties": {
        "lock_ttl_minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "datagen": {
      "description": "Synthetic data generator (datagen/).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "eval_seed",
        "volume_profile",
        "volume_profiles"
      ],
      "properties": {
        "seed": {
          "type": "integer"
        },
        "eval_seed": {
          "type": "integer"
        },
        "edge_case_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eval_only_scenarios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_drift": {
          "description": "FR-3 schema drift targets, applied in order (datagen/drift.py).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario",
              "source",
              "feed",
              "field"
            ],
            "properties": {
              "scenario": {
                "enum": [
                  "rename_column",
                  "add_column",
                  "remove_column",
                  "date_format",
                  "cast_failure"
                ]
              },
              "source": {
                "type": "string"
              },
              "feed": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        },
        "volume_profile": {
          "enum": [
            "ci",
            "full"
          ]
        },
        "volume_profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ci",
            "full"
          ],
          "properties": {
            "ci": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "records_per_file",
                "years"
              ],
              "properties": {
                "records_per_file": {
                  "type": "integer",
                  "minimum": 1
                },
                "years": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "full": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "records_per_file",
                "years"
              ],
              "properties": {
                "records_per_file": {
                  "type": "integer",
                  "minimum": 1
                },
                "years": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
